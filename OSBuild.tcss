Button {
    margin: 1 2;
}

Horizontal > VerticalScroll {
    width: 24;
}

.header {
    margin: 1 0 0 2;
    text-style: bold;
}

.title {
   text-style: bold;
   width: 50%;
}

#box1 {
    content-align: center middle;
}

#box2 {
   content-align: center middle;
}

/* Welcome screen */
#welcome {
    height: auto;
    padding: 1 2;
}

#banner {
    color: $accent;
}

#subtitle {
    margin: 1 0 1 2;
    color: $text-muted;
}

#menu {
    height: auto;
    margin: 1 0;
}

/* Section headings shared by the list and detail screens */
.section {
    margin: 1 0 0 2;
    text-style: bold;
    color: $accent;
}

/* Boards and ports tables */
#boards-table,
#ports-table {
    height: 1fr;
    margin: 1 2;
}

#boards-hint,
#ports-hint {
    margin: 0 2 1 2;
    color: $text-muted;
}

/* Board detail */
#detail {
    height: auto;
    max-height: 60%;
    padding: 0 2;
}

#board-summary,
#board-support,
#board-devices,
#board-sources {
    margin: 0 0 1 2;
}

#actions {
    height: auto;
    margin: 1 0;
}

#output {
    height: 1fr;
    margin: 0 2 1 2;
    border: round $accent;
}

/* New port form */
#newport {
    height: auto;
    padding: 1 2;
}

#newport Input,
#newport Select {
    margin: 0 0 1 0;
}

#scaffold-result {
    margin: 1 0;
    color: $text-muted;
}
